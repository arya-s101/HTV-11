# Optional. Without a key the landlord uses the scripted fallback (always used for the demo preset).
# Server-only: read in src/server/negotiation.ts, never sent to the browser.
GEMINI_API_KEY=
# Optional model override (default gemini-3.5-flash-lite).
GEMINI_MODEL=

# Multiplayer (PRD v4 Change 5), off unless all of these are set. Web config values are public by design;
# access is controlled by firestore.rules. Never put service-account keys here.
NEXT_PUBLIC_MULTIPLAYER=0
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
