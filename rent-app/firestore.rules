rules_version = '2';
// Party-mode rules (PRD v4 Change 5, single-player parity): every player plays the same seeded game on their own
// device; the room holds settings, shared scenes and a leaderboard. Signed-in members only; only the host changes
// room state; a player writes only their own player doc. Profile data is never stored: a name and a sprite only.
// Hackathon limitation: scores are self-reported, so rules only let a score go up, by a bounded amount per write.
service cloud.firestore {
  match /databases/{db}/documents {
    function signedIn() { return request.auth != null; }
    function room(code) { return get(/databases/$(db)/documents/rooms/$(code)).data; }
    function playerPath(code, uid) { return /databases/$(db)/documents/rooms/$(code)/players/$(uid); }
    function isMember(code) { return exists(playerPath(code, request.auth.uid)); }
    function isHost(code) { return room(code).hostUid == request.auth.uid; }
    function fresh(code) { return request.time < room(code).lastActivityAt + duration.value(2, 'h'); }
    // The host left or went quiet for a minute: a member may take over.
    function hostGone(code) {
      let hp = playerPath(code, room(code).hostUid);
      return !exists(hp) || get(hp).data.connected == false || get(hp).data.lastSeen < request.time - duration.value(60, 's');
    }
    function onlyKeys(keys) { return request.resource.data.diff(resource.data).affectedKeys().hasOnly(keys); }

    match /rooms/{code} {
      // Joiners may read a room to see whether it's open; player docs need membership.
      allow read: if signedIn();
      allow create: if signedIn()
        && code.matches('^[ABCDEFGHJKMNPQRSTUVWXYZ23456789]{6}$')
        && request.resource.data.hostUid == request.auth.uid
        && request.resource.data.status == 'lobby';
      allow update: if signedIn() && isMember(code) && (
        isHost(code)
        || (onlyKeys(['hostUid', 'lastActivityAt']) && request.resource.data.hostUid == request.auth.uid && hostGone(code))
      );
      allow delete: if false;

      match /players/{uid} {
        allow read: if signedIn() && isMember(code);
        allow create: if signedIn() && uid == request.auth.uid && room(code).status == 'lobby' && fresh(code)
          && request.resource.data.keys().hasOnly(['displayName', 'sprite', 'score', 'round', 'done', 'joinedAt', 'connected', 'lastSeen'])
          && request.resource.data.displayName is string && request.resource.data.displayName.size() <= 16
          && request.resource.data.score == 0;
        allow update: if signedIn() && (
          // A player updates their own presence and progress; the score only goes up, by at most 1,000 at once.
          (uid == request.auth.uid && onlyKeys(['connected', 'lastSeen', 'score', 'round', 'done'])
            && request.resource.data.score is int
            && request.resource.data.score >= resource.data.score
            && request.resource.data.score <= resource.data.score + 1000)
          // The host resets everyone for a new game in the same room.
          || (isHost(code) && onlyKeys(['score', 'round', 'done']) && request.resource.data.score == 0 && request.resource.data.done == false)
        );
        allow delete: if false;
      }
    }
  }
}
